{
  "name": "siu-gui",
  "version": "0.0.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run prepare:core && mygo dev",
    "build": "bun scripts/build.ts",
    "prepare:core": "bun scripts/core.ts",
    "dev:web": "vite",
    "build:web": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "bun tests/e2e.ts",
    "test:online": "bun tests/online.ts",
    "test:build": "bun test tests/build.test.ts tests/release.test.ts",
    "licenses": "bun tools/licenses.ts",
    "format": "prettier --write src tests scripts/*.ts tools/*.ts index.html vite.config.ts mygo.config.ts tsconfig.json package.json",
    "test:core": "cargo test --manifest-path core/Cargo.toml",
    "test:go": "go test ./...",
    "generate": "mygo generate",
    "generate:icon": "go run scripts/gen-icon.go"
  },
  "dependencies": {
    "lucide-react": "^1.70.0",
    "mygo-runtime": "0.8.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "agent-browser": "0.41.2",
    "jsdom": "^31.0.0",
    "mygo-cli": "0.8.3",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "8.3.6",
    "vitest": "^5.1.0"
  },
  "trustedDependencies": [
    "agent-browser"
  ]
}
